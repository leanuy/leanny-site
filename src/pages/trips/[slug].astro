---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

export async function getStaticPaths() {
  const trips = await getCollection('trips');
  return trips.map((trip) => ({
    params: { slug: trip.id },
    props: { trip },
  }));
}

const { trip } = Astro.props;
const { Content } = await render(trip);

const formatted = trip.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${trip.data.title} — leanny`} description={trip.data.summary}>
  <Nav />

  <main>
    <!-- Cover hero -->
    <div class="cover-hero">
      <div
        class="cover-img"
        style={trip.data.coverImage ? `background-image: url('${trip.data.coverImage}')` : ''}
      />
      <div class="cover-overlay" />
      <div class="cover-meta" data-animate>
        {trip.data.location && <span class="location">{trip.data.location}</span>}
        <h1>{trip.data.title}</h1>
        <span class="date">{formatted}</span>
      </div>
    </div>

    <!-- Content -->
    <article class="trip-article">
      <div class="container">
        <p class="summary" data-animate>{trip.data.summary}</p>
        <div class="prose" data-animate data-delay="100">
          <Content />
        </div>

        {trip.data.gallery && trip.data.gallery.length > 0 && (
          <div class="gallery" data-animate data-delay="150">
            <h2>gallery</h2>
            <div class="gallery-grid">
              {trip.data.gallery.map((img) => (
                <img src={img} alt="" loading="lazy" />
              ))}
            </div>
          </div>
        )}

        <div class="back-link" data-animate>
          <a href="/trips">← back to trips</a>
        </div>
      </div>
    </article>
  </main>

  <Footer />
</Base>

<style>
  main {
    min-height: 100vh;
  }

  /* Cover */
  .cover-hero {
    position: relative;
    height: 60vh;
    min-height: 320px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .cover-img {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
  }

  .cover-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(8, 8, 15, 0.2) 0%,
      rgba(8, 8, 15, 0.9) 100%
    );
  }

  .cover-meta {
    position: relative;
    z-index: 1;
    padding: 0 3rem 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .location {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #818cf8;
  }

  h1 {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 300;
    color: #f1f5f9;
    margin: 0;
    letter-spacing: 0.02em;
    line-height: 1.15;
  }

  .date {
    font-size: 0.8rem;
    color: #cbd5e1;
    letter-spacing: 0.06em;
  }

  /* Article */
  .trip-article {
    padding: 4rem 0 8rem;
  }

  .container {
    max-width: 780px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .summary {
    font-size: 1.1rem;
    color: #cbd5e1;
    line-height: 1.7;
    margin: 0 0 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Gallery */
  .gallery {
    margin-top: 4rem;
    padding-top: 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .gallery h2 {
    font-size: 0.85rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #cbd5e1;
    margin: 0 0 1.5rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .gallery-grid img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 0.75rem;
  }

  .back-link {
    margin-top: 4rem;
  }

  .back-link a {
    font-size: 0.85rem;
    color: #cbd5e1;
    text-decoration: none;
    letter-spacing: 0.06em;
    transition: color 0.2s;
  }

  .back-link a:hover {
    color: #cbd5e1;
  }

  @media (max-width: 640px) {
    .cover-meta {
      padding: 0 1.5rem 2.5rem;
    }
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
