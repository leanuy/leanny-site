---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Base title="leanny" description="Personal website">
  <Nav />

  <main>
    <section class="hero">
      <div class="hero-overlay" />
      <div class="hero-content">
        <h1 data-animate>leanny</h1>
        <p class="tagline" data-animate data-delay="150">
          places, thoughts, moments.
        </p>
        <div class="hero-links" data-animate data-delay="300">
          <a href="/trips" class="btn">explore trips</a>
          <a href="/about" class="btn-ghost">about me</a>
        </div>
      </div>
      <div class="scroll-hint" data-animate data-delay="600">
        <span>scroll</span>
        <div class="scroll-line" />
      </div>
    </section>

    <section class="section-intro">
      <div class="container">
        <div class="intro-grid">
          <div class="intro-card glass" data-animate>
            <span class="card-icon">✦</span>
            <h3>trips</h3>
            <p>Stories and photos from wherever life takes me.</p>
            <a href="/trips">view all →</a>
          </div>
          <div class="intro-card glass" data-animate data-delay="120">
            <span class="card-icon">◎</span>
            <h3>about</h3>
            <p>A little bit about who I am and what I'm up to.</p>
            <a href="/about">read more →</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>

<style>
  main {
    min-height: 100vh;
  }

  /* Hero */
  .hero {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(
      to bottom,
      rgba(1, 5, 8, 0.15) 0%,
      rgba(1, 5, 8, 0.05) 40%,
      rgba(1, 5, 8, 0.55) 80%,
      rgba(1, 5, 8, 0.92) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  h1 {
    font-size: clamp(4rem, 12vw, 9rem);
    font-weight: 300;
    letter-spacing: 0.18em;
    color: #f1f5f9;
    margin: 0;
    text-transform: lowercase;
  }

  .tagline {
    font-size: 1rem;
    color: #94a3b8;
    letter-spacing: 0.15em;
    margin: 0;
    text-transform: lowercase;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .btn {
    padding: 0.65rem 1.75rem;
    background: rgba(129, 140, 248, 0.15);
    border: 1px solid rgba(129, 140, 248, 0.35);
    color: #a5b4fc;
    border-radius: 0.5rem;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    transition: background 0.2s, color 0.2s;
    backdrop-filter: blur(8px);
  }

  .btn:hover {
    background: rgba(129, 140, 248, 0.28);
    color: #e0e7ff;
  }

  .btn-ghost {
    padding: 0.65rem 1.75rem;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #94a3b8;
    border-radius: 0.5rem;
    text-decoration: none;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    transition: border-color 0.2s, color 0.2s;
  }

  .btn-ghost:hover {
    border-color: rgba(255, 255, 255, 0.25);
    color: #e2e8f0;
  }

  .scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 2;
  }

  .scroll-hint span {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #94a3b8;
  }

  .scroll-line {
    width: 1px;
    height: 3rem;
    background: linear-gradient(to bottom, #94a3b8, transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.1); }
  }

  /* Intro section */
  .section-intro {
    position: relative;
    z-index: 1;
    padding: 6rem 0 8rem;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .intro-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .intro-card {
    padding: 2.5rem;
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .card-icon {
    font-size: 1.25rem;
    color: #818cf8;
    opacity: 0.7;
  }

  .intro-card h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 500;
    color: #f1f5f9;
    letter-spacing: 0.04em;
  }

  .intro-card p {
    margin: 0;
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.6;
  }

  .intro-card a {
    font-size: 0.85rem;
    color: #818cf8;
    text-decoration: none;
    letter-spacing: 0.04em;
    margin-top: auto;
    transition: color 0.2s;
  }

  .intro-card a:hover {
    color: #a5b4fc;
  }

  @media (max-width: 640px) {
    .intro-grid {
      grid-template-columns: 1fr;
    }

    .hero-links {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
