---
const year = new Date().getFullYear();
---

<footer>
  <span class="copy">&copy; {year} leanny</span>
  <div class="links">
    <a href="https://github.com/leanuy" target="_blank" rel="noopener">github</a>
    <a href="https://www.linkedin.com/in/leanuy-dev" target="_blank" rel="noopener">LinkedIn</a>
  </div>
</footer>

<style>
  footer {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 2rem 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    color: #94a3b8;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .links {
    display: flex;
    gap: 1.5rem;
  }

  .links a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
  }

  .links a:hover {
    color: #94a3b8;
  }

  @media (max-width: 640px) {
    footer {
      padding: 1.5rem;
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
    }
  }
</style>
