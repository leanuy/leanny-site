---
const links = [
  { href: '/', label: 'home' },
  { href: '/about', label: 'about' },
  { href: '/trips', label: 'trips' },
];

const current = Astro.url.pathname;
---

<nav class="nav-bar">
  <a href="/" class="nav-logo">leanny</a>
  <ul>
    {links.map(({ href, label }) => (
      <li>
        <a
          href={href}
          class:list={['nav-link', { active: current === href || (href !== '/' && current.startsWith(href)) }]}
        >
          {label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 3rem;
    background: rgba(8, 8, 15, 0.6);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .nav-logo {
    font-size: 1.1rem;
    font-weight: 600;
    color: #f1f5f9;
    text-decoration: none;
    letter-spacing: 0.05em;
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  .nav-logo:hover {
    opacity: 1;
  }

  ul {
    display: flex;
    gap: 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    font-size: 0.875rem;
    color: #cbd5e1;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: color 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: #e2e8f0;
  }

  .nav-link.active {
    color: #818cf8;
  }

  @media (max-width: 640px) {
    .nav-bar {
      padding: 1rem 1.5rem;
    }
    ul {
      gap: 1.25rem;
    }
  }
</style>
